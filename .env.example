# ==============================================================================
# RISHIKA BAGADIA PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel Production, add these keys under:
# Project Settings -> Environment Variables in vercel.com
# ==============================================================================

# [Optional] Cloudflare Turnstile Spam Defense
# Create a free widget at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# [Optional] Destination Email for Direct Inquiries
# When configured, inquiries submitted through the contact form are dispatched here.
CONTACT_RECEIVER_EMAIL=rishikabagadia@gmail.com

# [Optional] Resend API Key for Transactional Email Delivery (https://resend.com)
# When set, the /api/contact serverless function dispatches notifications automatically.
RESEND_API_KEY=

# [Optional] Rate Limiting Configuration
# Maximum inquiries permitted per IP address within the rate window (defaults to 5).
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=10
